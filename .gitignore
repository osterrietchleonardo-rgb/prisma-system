# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# Copias de seguridad del .env. Aparecen solas cuando una herramienta toca la
# configuración (ej. .env.bak-composio) y traen la SUPABASE_SERVICE_ROLE_KEY,
# que saltea todos los permisos de la base. Ojo: NO usar `.env.*` acá, porque
# .env.example sí va versionado.
.env.bak*
.env.backup*

# Sesiones guardadas de navegador: cookies vivas de una cuenta real
# (ej. linkedin-auth.json, que lo escribe la automatización de LinkedIn).
*auth.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Documentación particular por cliente (interna, NO se sube al repo)
docs/compartible/particular/*
!docs/compartible/particular/README.md

# Scratch / secretos locales (contienen API keys de Tokko)
_tokko_explore/
.mcp.json

# Backups de workflows de n8n (los exports incluyen credenciales en texto plano)
scratch/n8n-backups/

# Estado diario del Socio (se regenera solo)
.claude/skills/vakdor-socio/estado/
.claude/skills/vakdor-socio/node_modules/

# Capturas de Playwright: guardan el contenido de la pantalla, contraseñas incluidas
.playwright-cli/

# Carpeta de trabajo sucio: respaldos de n8n, volcados de datos y pruebas sueltas.
# Ahi adentro aparecen secretos -- un export de n8n trae los headers escritos ADENTRO del
# flujo -- asi que nada nuevo de aca se versiona. Los 6 archivos que YA estaban versionados
# siguen igual: se revisaron uno por uno y no tienen claves, y uno de ellos,
# scratch/clickup-ids.json, lo usa el CLAUDE.md.
scratch/

# Artefactos operativos de mercado-sync (JSON scrapeados y checkpoints): no versionar.
mercado-sync/data/
